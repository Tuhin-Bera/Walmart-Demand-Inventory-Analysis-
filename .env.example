# ==============================================================================
# .env.example — Environment Variables Template
# Copy this file to .env and configure for your local or cloud environment.
# ==============================================================================

# ── Server Gateway Configuration ──────────────────────────────────────────────
# Use 127.0.0.1 for local desktop execution, 0.0.0.0 for Docker container / Cloud VM
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Data Pipeline & Windowing Settings ─────────────────────────────────────────
# Number of trailing days to melt and keep in-memory (180 days = ~350MB RAM, fast response)
HISTORY_DAYS=180

# Benchmark store IDs (comma-separated). Leave empty to load all stores in dataset
SAMPLE_STORES=CA_1,TX_1,WI_1

# Evaluation holdout horizon in days (default: 28 days for M5 competition standard)
N_EVAL_DAYS=28

# ── Prescriptive Inventory Optimization Constants (Newsvendor) ────────────────
# Holding cost per unit per day ($)
DEFAULT_HOLDING_COST=0.20

# Stockout penalty cost per unsatisfied unit ($)
DEFAULT_STOCKOUT_COST=2.00

# Normal safety stock z-factor (1.65 for 95% cycle-service level, 2.33 for 99%)
DEFAULT_SAFETY_STOCK_FACTOR=1.65

# ── Cloud Deployment Dataset Download URLs (Render / Cloud) ───────────────────
# If deploying to Render, upload large CSVs to Google Drive, set sharing to
# "Anyone with the link can view", and paste the share URLs below:
DATA_SALES_VALIDATION_URL=https://drive.google.com/file/d/1BMf1VgeAkkwmlEsdliqQ3cIr1oxvC6fU/view?usp=sharing
DATA_SELL_PRICES_URL=https://drive.google.com/file/d/10LCz2fDeDwkDMwLe_Eqc9nd0b3_T5B_h/view?usp=sharing
DATA_SALES_EVALUATION_URL=
DATA_CALENDAR_URL=

